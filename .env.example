# Database
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Authentication
JWT_SECRET=your_secure_random_secret_min_32_characters_change_in_production

# Google Sign-In (Knowfy Android/iOS → POST /auth/google/mobile)
# Comma-separated allowed “audiences” — use your OAuth Web client ID from Google Cloud Console
# (same value Flutter passes as GoogleSignIn(serverClientId: ...) / dart-define GOOGLE_WEB_CLIENT_ID).
GOOGLE_SIGN_IN_AUDIENCE=123456.apps.googleusercontent.com

# CORS - Comma separated allowed origins
ALLOWED_ORIGINS=https://your-admin-portal.com,https://your-app.com

# Server
PORT=5000
NODE_ENV=production
